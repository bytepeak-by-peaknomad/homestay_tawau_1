# Neon Postgres connection string (Vercel Postgres is now Neon).
# Create a Neon project via the Vercel Marketplace or neon.tech, then paste
# the connection string here and into your Vercel project environment variables.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Secret used by the /admin page to issue review links. Make it long and random.
ADMIN_SECRET="owneronlyaccess"
